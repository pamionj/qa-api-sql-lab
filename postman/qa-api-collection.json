    {
      "name": "POST Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Test 1: Validar que el servidor responda con 201 (Created)\r",
              "// 201 indica que el recurso fue creado exitosamente\r",
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "// Test 2: Validar que el usuario fue creado correctamente\r",
              "pm.test(\"User created correctly\", function () {\r",
              "\r",
              "    // Convertimos la respuesta a objeto JSON\r",
              "    const json = pm.response.json();\r",
              "\r",
              "    // Verificamos que existan los campos esperados\r",
              "    pm.expect(json).to.have.property(\"name\");\r",
              "    pm.expect(json).to.have.property(\"email\");\r",
              "\r",
              "    // Validamos que los valores coincidan con los enviados en el body\r",
              "    pm.expect(json.name).to.eql(\"Pablo\");\r",
              "    pm.expect(json.email).to.eql(\"pablo@test.com\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"Pablo\",\r\n  \"email\": \"pablo@test.com\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
